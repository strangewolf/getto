generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Org {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  users           User[]
  locations       Location[]
  orders          Order[]
  vehicles        Vehicle[]
  drivers         Driver[]
  trips           Trip[]
  stockTransfers  StockTransfer[]
  events          BusinessEvent[]

  @@map("orgs")
}

model Role {
  id        String     @id @default(uuid())
  name      String     @unique
  userRoles UserRole[]

  @@map("roles")
}

model User {
  id           String   @id @default(uuid())
  orgId        String   @map("org_id")
  email        String   @unique
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  org             Org             @relation(fields: [orgId], references: [id])
  roles           UserRole[]
  driverProfile   Driver?         @relation("UserDriver")
  ordersCreated   Order[]         @relation("OrderCreatedBy")
  transfersCreated StockTransfer[] @relation("TransferCreatedBy")
  events          BusinessEvent[]

  @@map("users")
}

model UserRole {
  id     String @id @default(uuid())
  userId String @map("user_id")
  roleId String @map("role_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model Location {
  id        String   @id @default(uuid())
  orgId     String   @map("org_id")
  type      String
  name      String
  address   String?
  lat       Float?
  lng       Float?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  org       Org                 @relation(fields: [orgId], references: [id])
  inventory InventoryBalance[]
  ordersRetail Order[]          @relation("OrderRetailer")
  ordersWh     Order[]          @relation("OrderWarehouse")
  tripsWh      Trip[]           @relation("TripWarehouse")
  tripStops    TripStop[]
  transfersFrom StockTransfer[] @relation("TransferFrom")
  transfersTo   StockTransfer[] @relation("TransferTo")

  @@map("locations")
}

model SKU {
  id        String   @id @default(uuid())
  skuCode   String   @unique @map("sku_code")
  name      String
  uom       String   @default("unit")
  weightKg  Float?   @map("weight_kg")
  volumeM3  Float?   @map("volume_m3")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  batches   Batch[]
  inventory InventoryBalance[]
  orderLines OrderLine[]
  transferLines StockTransferLine[]

  @@map("skus")
}

model Batch {
  id             String    @id @default(uuid())
  skuId          String    @map("sku_id")
  batchCode      String    @map("batch_code")
  productionDate DateTime? @map("production_date")
  qtyProduced    Float     @default(0) @map("qty_produced")
  createdAt      DateTime  @default(now()) @map("created_at")

  sku SKU @relation(fields: [skuId], references: [id])

  @@map("batches")
}

model InventoryBalance {
  id         String @id @default(uuid())
  locationId String @map("location_id")
  skuId      String @map("sku_id")
  onHand     Float  @default(0) @map("on_hand")
  reserved   Float  @default(0)

  location    Location     @relation(fields: [locationId], references: [id])
  sku         SKU          @relation(fields: [skuId], references: [id])
  allocations Allocation[]

  @@unique([locationId, skuId])
  @@map("inventory_balances")
}

model Order {
  id                    String    @id @default(uuid())
  orgId                 String    @map("org_id")
  retailerLocationId    String    @map("retailer_location_id")
  warehouseLocationId   String    @map("warehouse_location_id")
  status                String    @default("pending_allocation")
  priority              Int       @default(0)
  requestedWindowStart  DateTime? @map("requested_window_start")
  requestedWindowEnd    DateTime? @map("requested_window_end")
  notes                 String?
  createdByUserId       String?   @map("created_by_user_id")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  org               Org       @relation(fields: [orgId], references: [id])
  retailerLocation  Location  @relation("OrderRetailer", fields: [retailerLocationId], references: [id])
  warehouseLocation Location  @relation("OrderWarehouse", fields: [warehouseLocationId], references: [id])
  createdBy         User?     @relation("OrderCreatedBy", fields: [createdByUserId], references: [id])
  lines             OrderLine[]

  @@map("orders")
}

model OrderLine {
  id            String  @id @default(uuid())
  orderId       String  @map("order_id")
  skuId         String  @map("sku_id")
  qtyRequested  Float   @map("qty_requested")
  qtyAllocated  Float   @default(0) @map("qty_allocated")
  status        String  @default("pending")

  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sku         SKU            @relation(fields: [skuId], references: [id])
  allocations Allocation[]
  deliveries  StopDelivery[]

  @@map("order_lines")
}

model Allocation {
  id                 String   @id @default(uuid())
  orderLineId        String   @map("order_line_id")
  inventoryBalanceId String   @map("inventory_balance_id")
  qty                Float
  createdAt          DateTime @default(now()) @map("created_at")

  orderLine        OrderLine        @relation(fields: [orderLineId], references: [id], onDelete: Cascade)
  inventoryBalance InventoryBalance @relation(fields: [inventoryBalanceId], references: [id])

  @@map("allocations")
}

model Vehicle {
  id          String   @id @default(uuid())
  orgId       String   @map("org_id")
  regNumber   String   @unique @map("reg_number")
  capacityKg  Float?   @map("capacity_kg")
  capacityM3  Float?   @map("capacity_m3")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  org   Org    @relation(fields: [orgId], references: [id])
  trips Trip[]

  @@map("vehicles")
}

model Driver {
  id        String   @id @default(uuid())
  orgId     String   @map("org_id")
  userId    String?  @unique @map("user_id")
  name      String
  phone     String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  org   Org    @relation(fields: [orgId], references: [id])
  user  User?  @relation("UserDriver", fields: [userId], references: [id])
  trips Trip[]

  @@map("drivers")
}

model Trip {
  id                  String    @id @default(uuid())
  orgId               String    @map("org_id")
  warehouseLocationId String    @map("warehouse_location_id")
  status              String    @default("draft")
  vehicleId           String?   @map("vehicle_id")
  driverId            String?   @map("driver_id")
  plannedStart        DateTime? @map("planned_start")
  dispatchedAt        DateTime? @map("dispatched_at")
  completedAt         DateTime? @map("completed_at")
  createdAt           DateTime  @default(now()) @map("created_at")

  org               Org       @relation(fields: [orgId], references: [id])
  warehouseLocation Location  @relation("TripWarehouse", fields: [warehouseLocationId], references: [id])
  vehicle           Vehicle?  @relation(fields: [vehicleId], references: [id])
  driver            Driver?   @relation(fields: [driverId], references: [id])
  stops             TripStop[]
  costs             TripCost[]

  @@map("trips")
}

model TripStop {
  id         String    @id @default(uuid())
  tripId     String    @map("trip_id")
  sequence   Int
  locationId String    @map("location_id")
  status     String    @default("pending")
  eta        DateTime?
  arrivedAt  DateTime? @map("arrived_at")

  trip        Trip             @relation(fields: [tripId], references: [id], onDelete: Cascade)
  location    Location         @relation(fields: [locationId], references: [id])
  deliveries  StopDelivery[]

  @@map("trip_stops")
}

model StopDelivery {
  id            String    @id @default(uuid())
  tripStopId    String    @map("trip_stop_id")
  orderLineId   String    @map("order_line_id")
  qtyPlanned    Float     @map("qty_planned")
  qtyDelivered  Float     @default(0) @map("qty_delivered")
  status        String    @default("pending")
  reasonCode    String?   @map("reason_code")
  signatureUrl  String?   @map("signature_url")
  photoUrl      String?   @map("photo_url")
  podCapturedAt DateTime? @map("pod_captured_at")

  tripStop  TripStop  @relation(fields: [tripStopId], references: [id], onDelete: Cascade)
  orderLine OrderLine @relation(fields: [orderLineId], references: [id])

  @@map("stop_deliveries")
}

model TripCost {
  id        String   @id @default(uuid())
  tripId    String   @map("trip_id")
  category  String
  amount    Float
  currency  String   @default("INR")
  notes     String?
  postedAt  DateTime @default(now()) @map("posted_at")

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@map("trip_costs")
}

model BusinessEvent {
  id           String   @id @default(uuid())
  orgId        String?  @map("org_id")
  eventType    String   @map("event_type")
  payload      Json?
  actorUserId  String?  @map("actor_user_id")
  createdAt    DateTime @default(now()) @map("created_at")

  org   Org?  @relation(fields: [orgId], references: [id])
  actor User? @relation(fields: [actorUserId], references: [id])

  @@index([eventType])
  @@index([createdAt])
  @@map("events")
}

model StockTransfer {
  id                String   @id @default(uuid())
  orgId             String   @map("org_id")
  fromLocationId    String   @map("from_location_id")
  toLocationId      String   @map("to_location_id")
  status            String   @default("draft")
  notes             String?
  createdByUserId   String?  @map("created_by_user_id")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  org          Org                 @relation(fields: [orgId], references: [id])
  fromLocation Location            @relation("TransferFrom", fields: [fromLocationId], references: [id])
  toLocation   Location            @relation("TransferTo", fields: [toLocationId], references: [id])
  createdBy    User?               @relation("TransferCreatedBy", fields: [createdByUserId], references: [id])
  lines        StockTransferLine[]

  @@map("stock_transfers")
}

model StockTransferLine {
  id            String @id @default(uuid())
  transferId    String @map("transfer_id")
  skuId         String @map("sku_id")
  qtyRequested  Float  @map("qty_requested")
  qtyShipped    Float  @default(0) @map("qty_shipped")
  qtyReceived   Float  @default(0) @map("qty_received")

  transfer StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  sku      SKU           @relation(fields: [skuId], references: [id])

  @@map("stock_transfer_lines")
}
